// General description
manifest {
    name           = 'Phylotranscriptomics Pipeline PhyloTransPip'
    author         = 'Nicolas Nesi'
    homePage       = 'https://github.com/NicolasNesi/PHYLOTRANSPIP'
    description    = """Nextflow pipeline from RNAseq reads to CDSs for phylogenomics and comparative genomics analyses"""
    mainScript     = 'main.nf'
    version = '0.0.1'
}

params {
    config_profile_description = 'The Austral CRIANN cluster setting for the PhyloTrans pipeline in Nextflow'
    config_profile_contact = 'Nicolas Nesi'
    outdir = 'results'
}

apptainer {
    enabled = false
}

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 2 — Mamba environments
// ══════════════════════════════════════════════════════════════════════════════

def ptp_activate = '''
    module load py_env/miniconda3/25.7.0
    set +u
    eval "$(conda shell.bash hook)"
    conda activate ptp_env
    set -u
'''

def trinity_activate = '''
    module load py_env/miniconda3/25.7.0
    set +u
    eval "$(conda shell.bash hook)"
    conda activate trinity_env
    set -u
'''

def busco_activate = '''
    module load py_env/miniconda3/25.7.0
    set +u
    eval "$(conda shell.bash hook)"
    conda activate busco_env
    set -u
'''

def transdecoder_activate = '''
    module load py_env/miniconda3/25.7.0
    set +u
    eval "$(conda shell.bash hook)"
    conda activate transdecoder_env
    set -u
'''

def python2_activate = '''
    module load py_env/miniconda3/25.7.0
    set +u
    eval "$(conda shell.bash hook)"
    conda activate python2_env
    set -u
'''

def guidance3_activate = '''
    module load py_env/miniconda3/25.7.0
    set +u
    eval "$(conda shell.bash hook)"
    conda activate guidance3_env
    set -u
'''

def phylo_activate = '''
    module load py_env/miniconda3/25.7.0
    set +u
    eval "$(conda shell.bash hook)"
    conda activate phylo_env
    set -u
'''

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 3 — Per-step configuration  (withName)
// ══════════════════════════════════════════════════════════════════════════════

process {
    executor      = 'slurm'
    errorStrategy = { sleep(Math.pow(2, task.attempt) * 150 as long); return 'retry' }
    maxRetries    = 3

    withName: 'WGETSRA' {
        beforeScript = ptp_activate
        memory = 100.GB
        cpus = 48
        time = '11.h'
        clusterOptions = '--partition=2tcourt'
    }

    withName: 'RCORRECT' {
        beforeScript = ptp_activate
        memory = 200.GB
        cpus = 96
        time = '290.h'
        clusterOptions = '--partition=tlong'
    }

    withName: 'TRIMGALORE' {
        beforeScript = ptp_activate
        memory = 100.GB
        cpus = 24
        time = '23.h'
        clusterOptions = '--partition=tcourt'
    }

    withName: 'DECONTAM_MAP' {
        beforeScript = ptp_activate
        memory = 100.GB
        cpus = 24
        time = '23.h'
        clusterOptions = '--partition=tcourt'
    }

    withName: 'QCTRIM' {
        beforeScript = ptp_activate
        memory = 6.GB
        cpus = 24
        time = '11.h'
        clusterOptions = '--partition=2tcourt'
    }

    withName: 'BOWTIEFILTER' {
        beforeScript = ptp_activate
        memory = 200.GB
        cpus = 48
        time = '23.h'
        clusterOptions = '--partition=court'
    }

    withName: 'FILTEROVERREP' {
        beforeScript = ptp_activate
        memory = 200.GB
        cpus = 48
        time = '23.h'
        clusterOptions = '--partition=court'
    }

    withName: 'TRINITY' {
        beforeScript = trinity_activate
        memory = 400.GB
        cpus = 48
        time = '47.h'
        clusterOptions = '--partition=court'
    }

    withName: 'STATSTRINITY' {
        beforeScript = trinity_activate
        memory = 10.GB
        cpus = 4
        time = '1.h'
        clusterOptions = '--partition=2tcourt'
    }

    withName: 'REBOWTIE' {
        beforeScript = ptp_activate
        memory = 200.GB
        cpus = 48
        time = '2.h'
        clusterOptions = '--partition=2tcourt'
    }

    withName: 'TRANSRATE' {
        beforeScript = ptp_activate
        memory = 400.GB
        cpus = 48
        time = '23.h'
        clusterOptions = '--partition=tcourt'
    }

    withName: 'CHIMERA' {
        beforeScript = python2_activate
        memory = 200.GB
        cpus = 48
        time = '11.h'
        clusterOptions = '--partition=2tcourt'
    }

    withName: 'CORSET' {
        beforeScript = ptp_activate
        memory = 200.GB
        cpus = 48
        time = '11.h'
        clusterOptions = '--partition=2tcourt'
    }

    withName: 'TRANSDECODER' {
        beforeScript = transdecoder_activate
        memory = 200.GB
        cpus = 48
        time = '11.h'
        clusterOptions = '--partition=2tcourt'
    }

    withName: 'CDHIT' {
        beforeScript = ptp_activate
        memory = 500.GB
        cpus = 96
        time = '11.h'
        clusterOptions = '--partition=2tcourt'
    }

    withName: 'RCPBLAST' {
        beforeScript = trinity_activate
        memory = 200.GB
        cpus = 48
        time = '11.h'
        clusterOptions = '--partition=2tcourt'
    }

    withName: 'FILTERFASTA' {
        beforeScript = ptp_activate
        memory = 20.GB
        cpus = 48
        time = '11.h'
        clusterOptions = '--partition=2tcourt'
    }

    withName: 'MAKEMULTIFASTA' {
        beforeScript = ptp_activate
        memory = 10.GB
        cpus = 48
        time = '11.h'
        clusterOptions = '--partition=2tcourt'
    }

    withName: 'GUIDANCE' {
        beforeScript = guidance3_activate
        memory = 400.GB
        cpus = 48
        time = '47.h'
        clusterOptions = '--partition=court'
    }

    withName: 'FILTERALIGNMENTS' {
        beforeScript = ptp_activate
        memory = 50.GB
        cpus = 48
        time = '11.h'
        clusterOptions = '--partition=2tcourt'
    }

    withName: 'GENETREE' {
        beforeScript = phylo_activate
        memory = 50.GB
        cpus = 48
        time = '23.h'
        clusterOptions = '--partition=tcourt'
    }

    withName: 'QCTREE' {
        beforeScript = ptp_activate
        memory = 100.GB
        cpus = 48
        time = '23.h'
        clusterOptions = '--partition=tcourt'
    }

    withName: 'BUSCO' {
        beforeScript = busco_activate
        memory = 200.GB
        cpus = 48
        time = '11.h'
        clusterOptions = '--partition=2tcourt'
    }

    withName: 'MITOGENOMES' {
        beforeScript = phylo_activate
        memory = 100.GB
        cpus = 48
        time = '11.h'
        clusterOptions = '--partition=2tcourt'
    }

    withName: 'CONCATENATION' {
        beforeScript = ptp_activate
        memory = 100.GB
        cpus = 48
        time = '11.h'
        clusterOptions = '--partition=2tcourt'
    }

    withName: 'GENETREE2' {
        beforeScript = phylo_activate
        memory = 50.GB
        cpus = 48
        time = '23.h'
        clusterOptions = '--partition=tcourt'
    }

    withName: 'STATSALGTREE' {
        beforeScript = ptp_activate
        memory = 50.GB
        cpus = 48
        time = '23.h'
        clusterOptions = '--partition=tcourt'
    }
}

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 4 — Profiles
// ══════════════════════════════════════════════════════════════════════════════

profiles {
    standard {
        params {
            max_memory = 700.GB
            max_cpus   = 96
        }
        executor {
            queueSize    = 50
            pollInterval = '2 min'
        }
    }
}

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 6 — Execution reporting
// ══════════════════════════════════════════════════════════════════════════════

def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${trace_timestamp}.html"
}

report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${trace_timestamp}.html"
}

trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${trace_timestamp}.txt"
}

dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${trace_timestamp}.html"
}